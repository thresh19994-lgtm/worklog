---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getPublished } from '../../lib/content';

const projects = await getPublished('projects');
const order = (s: string) => (s === '진행 중' ? 0 : 1);
projects.sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || order(a.data.status) - order(b.data.status));
---

<BaseLayout title="프로젝트" description="게임 기획 프로젝트와 기획 결정 로그">
  <h1>프로젝트</h1>
  <p class="lead">각 프로젝트에 내 역할, 핵심 기획 결정, 결과물, 회고, 기획 결정 로그가 있습니다.</p>
  <PostList
    items={projects.map((p) => ({
      href: `/projects/${p.id}/`,
      title: p.data.title,
      date: p.data.date,
      summary: `${p.data.role} · ${p.data.period} — ${p.data.summary}`,
      badge: p.data.featured ? '대표작' : p.data.status,
    }))}
  />
</BaseLayout>
