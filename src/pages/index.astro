---
// 홈(고정형): 역할·역량 3줄 → 대표작 → 진행 중 프로젝트 → 연락처. 자동 생성 신문은 넣지 않는다.
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../site';
import { getPublished } from '../lib/content';

const projects = await getPublished('projects');
const featured = projects.find((p) => p.data.featured);
const inProgress = projects.filter((p) => p.data.status === '진행 중' && p.id !== featured?.id);
const featuredPdf = featured?.data.outputs.find((o) => o.url.toLowerCase().endsWith('.pdf'));
---

<BaseLayout>
  <section class="hero" data-pagefind-body>
    <p class="role">{SITE.role}</p>
    <h1>{SITE.name}</h1>
    <ul class="strengths">
      {SITE.strengths.map((s) => <li>{s}</li>)}
    </ul>
    <div class="socials">
      <a href={`mailto:${SITE.email}`}><Icon name="mail" />{SITE.email}</a>
      {
        SITE.github && (
          <a href={SITE.github}>
            <Icon name="github" />
            GitHub
          </a>
        )
      }
    </div>
  </section>

  {
    featured && (
      <section aria-labelledby="featured-title">
        <h2 class="section-title" id="featured-title">대표작</h2>
        <ul class="post-list">
          <li>
            <a class="title" href={`/projects/${featured.id}/`}>
              <h3 style="font:inherit;margin:0">{featured.data.title}</h3>
            </a>
            <Image
              class="feature-img"
              src={featured.data.cover}
              alt={featured.data.cover_alt}
              widths={[400, 768, 1200]}
              sizes="(max-width: 768px) 100vw, 736px"
              loading="eager"
              fetchpriority="high"
            />
            <dl class="facts">
              <dt>내 역할</dt>
              <dd>{featured.data.role}</dd>
              <dt>기간</dt>
              <dd>{featured.data.period}</dd>
            </dl>
            <p>{featured.data.summary}</p>
            <div class="btn-row">
              {featuredPdf && (
                <a class="btn" href={featuredPdf.url}>
                  <Icon name="file" size={18} />
                  {featuredPdf.label}
                </a>
              )}
              <a class="btn ghost" href={`/projects/${featured.id}/`}>
                프로젝트 자세히 보기
              </a>
            </div>
          </li>
        </ul>
      </section>
    )
  }

  {
    inProgress.length > 0 && (
      <section aria-labelledby="wip-title">
        <h2 class="section-title" id="wip-title">진행 중</h2>
        <PostList
          items={inProgress.map((p) => ({
            href: `/projects/${p.id}/`,
            title: p.data.title,
            date: p.data.date,
            summary: `${p.data.role} · ${p.data.period} — ${p.data.summary}`,
          }))}
        />
      </section>
    )
  }

  <section aria-labelledby="contact-title">
    <h2 class="section-title" id="contact-title">연락처</h2>
    <p>
      채용·협업 문의는 이메일로 부탁드립니다. <a href={`mailto:${SITE.email}`} style="color:var(--accent)">{SITE.email}</a>
    </p>
  </section>
</BaseLayout>
