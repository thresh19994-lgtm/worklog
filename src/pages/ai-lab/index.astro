---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getPublished, entryUrl } from '../../lib/content';

const posts = await getPublished('ai-lab');
---

<BaseLayout title="AI 활용 사례" description="문제 → 선택지 → 결정 → 검증 → 전후 비교 → 배운 점으로 정리한 AI 활용 사례">
  <h1>AI 활용 사례</h1>
  <p class="lead">도구 사용 기록이 아니라, 문제를 어떻게 풀었는지를 기록합니다. 게임 기획 사례를 먼저 둡니다.</p>
  <PostList
    items={posts.map((p) => ({
      href: entryUrl('ai-lab', p.id),
      title: p.data.title,
      date: p.data.date,
      summary: p.data.summary,
    }))}
  />
</BaseLayout>
