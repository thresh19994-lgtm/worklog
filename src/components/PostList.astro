---
// 글 목록 카드 (AstroPaper Card.astro 모양)
import Icon from './Icon.astro';
import { formatDate, isoDate } from '../lib/content';

interface Item {
  href: string;
  title: string;
  date: Date;
  summary?: string;
  badge?: string;
  auto?: boolean;
}

interface Props {
  items: Item[];
  empty?: string;
  heading?: 'h2' | 'h3';
}

const { items, empty = '아직 글이 없습니다.', heading: Heading = 'h3' } = Astro.props;
---

{
  items.length === 0 ? (
    <p class="muted">{empty}</p>
  ) : (
    <ul class="post-list">
      {items.map((item) => (
        <li>
          <a class="title" href={item.href}>
            <Heading style="font:inherit;margin:0">{item.title}</Heading>
          </a>
          <div class="meta">
            <time datetime={isoDate(item.date)}>
              <Icon name="calendar" size={18} />
              {formatDate(item.date)}
            </time>
            {item.badge && <span class:list={['badge', { auto: item.auto }]}>{item.badge}</span>}
          </div>
          {item.summary && <p>{item.summary}</p>}
        </li>
      ))}
    </ul>
  )
}
