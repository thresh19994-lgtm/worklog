---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import PostMeta from '../components/PostMeta.astro';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  summary: string;
  date: Date;
  ai_assist: string;
  tags?: string[];
  section?: { href: string; label: string };
  news?: boolean;
  /** render(entry)가 돌려준 제목 목록. 본문 밖에서 만든 제목(예: 프로젝트 블록)은 extraHeadings로 넘긴다. */
  headings?: MarkdownHeading[];
  extraHeadings?: { slug: string; text: string; depth?: number }[];
}

const {
  title,
  summary,
  date,
  ai_assist,
  tags = [],
  section,
  news = false,
  headings = [],
  extraHeadings = [],
} = Astro.props;

// 목차: h2·h3가 3개 이상일 때만 보인다
const toc = [
  ...headings.filter((h) => h.depth === 2 || h.depth === 3),
  ...extraHeadings.map((h) => ({ depth: h.depth ?? 2, slug: h.slug, text: h.text })),
];
const showToc = toc.length >= 3;
---

<BaseLayout title={title} description={summary} noindex={news}>
  <article data-pagefind-body={news ? undefined : ''}>
    {
      section && (
        <a class="back" href={section.href}>
          <Icon name="arrow-left" size={18} />
          {section.label}
        </a>
      )
    }
    <h1 id="top" style="color:var(--accent)">{title}</h1>
    <PostMeta date={date} ai_assist={ai_assist} tags={tags} linkTags={!news} />
    {
      news && (
        <p class="notice" role="note">
          <strong>Claude가 수집·요약한 자동 생성 문서</strong>입니다. 사람이 쓴 글이 아니며, 사실 관계는 출처에서 확인해 주세요.
        </p>
      )
    }
    {
      showToc && (
        <details class="toc" open>
          <summary>목차</summary>
          <ol>
            {toc.map((h) => (
              <li class={`depth-${h.depth}`}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </details>
      )
    }
    <div class="prose">
      <slot />
    </div>
    <a class="to-top" href="#top">
      <Icon name="arrow-up" size={18} />
      맨 위로
    </a>
  </article>
</BaseLayout>
